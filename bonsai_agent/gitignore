# =========================================================
# 天工慧眼（Tiangong Huiyan）项目 .gitignore
# 作用：避免把虚拟环境、密钥、缓存、运行数据库等提交到 GitHub
# =========================================================

# -------------------------
# Python 缓存 / 编译文件
# -------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# -------------------------
# Python 虚拟环境
# -------------------------
venv/
.venv/
env/
ENV/

# -------------------------
# 环境变量 / 密钥配置
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# SSH / 私钥 / 证书
# -------------------------
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.pem
*.key
*.p12
*.pfx

# -------------------------
# SQLite 运行数据库
# -------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
data/tiangong_huiyan.db

# -------------------------
# 日志 / 临时运行文件
# -------------------------
*.log
logs/
tmp/
temp/
*.tmp

# -------------------------
# IDE / 编辑器
# -------------------------
.vscode/
.idea/
*.code-workspace

# -------------------------
# 操作系统生成文件
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Python 打包产物
# -------------------------
build/
dist/
*.egg-info/
.eggs/

# -------------------------
# YOLO / AI 训练输出
# -------------------------
runs/
wandb/

# 模型权重通常较大，默认不提交 GitHub。
# 后续如需共享 best.pt，建议使用 Git LFS 或单独发布。
models/*.pt
models/*.pth
models/*.onnx
models/*.engine

# -------------------------
# 本地测试图片 / 临时采集数据
# -------------------------
test_images/
captures/
screenshots/

# -------------------------
# 其他本地备份文件
# -------------------------
*.bak
*.backup
*.old
*~
