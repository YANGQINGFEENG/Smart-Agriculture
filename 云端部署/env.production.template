# ============================================================
# 天工慧眼 - 生产环境变量模板
# 部署时复制到服务器项目根目录并重命名为 .env.local
#   cp env.production.template /opt/smart-agriculture/.env.local
# 密码为占位值，部署时请改为强密码（与 server-init.sh 中设置的
# MySQL root 密码保持一致）
# ============================================================

# ---------- 数据库（服务器本机 MySQL） ----------
DATABASE_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CloudMysql@2026
DB_NAME=smart_agriculture

# ---------- WebSocket 命令中继（仅本机，不对外） ----------
WS_RELAY_URL=http://localhost:8081

# ---------- 应用 ----------
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ---------- AI（本次不部署本地 AI 服务，走网络 API，未配 Key 时相关功能自动降级） ----------
AI_MODE=network
AI_INFERENCE_TIMEOUT=30000
AI_DIAGNOSIS_TIMEOUT=120000

# ---------- 日志 ----------
LOG_LEVEL=info
